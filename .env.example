DISCORD_TOKEN=""
MEMBER_ROLE_ID=""
NEWS_CHANNEL_ID=""
SUPABASE_SECRET_KEY=""
SUPABASE_URL=""

# Optional (set to defaults)
NEWS_ALERT_CRON="0 9,17 * * *"
NEWS_ALERT_KEYWORDS="critical,zero-day,zero day"
NEWS_DIGEST_CRON="* * * * *"
NEWS_TIMEZONE="Australia/Sydney"

# Staff-only channel where scheduled Instagram and LinkedIn posts are handed to a person.
# Leave empty and the hand-off task stays asleep.
SOCIAL_HANDOFF_CHANNEL_ID=""

# Publishing to Instagram and LinkedIn through Zernio, which holds the Meta and LinkedIn
# approvals a club cannot get quickly. Leave empty and every due post is handed to a person
# instead. Switch on per platform with the publish_instagram / publish_linkedin flags.
ZERNIO_API_KEY=""

# The DUCA LinkedIn company page, as urn:li:organization:123456. Without it a LinkedIn post
# would go out under the personal profile of whoever linked the account, so the bot refuses.
ZERNIO_LINKEDIN_ORGANIZATION_URN=""

# Only needed if more than one account of a platform is connected to Zernio.
ZERNIO_INSTAGRAM_ACCOUNT_ID=""
ZERNIO_LINKEDIN_ACCOUNT_ID=""
